-- main --

-- const
game_states = {"menu","game","game_over"}

-- var
local state = game_states[1]
gm = {}
e = {}

-- debug
b = {}

p = {}


function _init()
	start_game()
	add(e,enemy.new(36,100))
	add(e,enemy.new(84,100))
	p = player.new(player_sp)
	-- debug
	
end

function _update()
	if state == game_states[1] then
		update_menu()
	elseif state == game_states[2] then
		update_game()
	elseif state == game_states[3] then
		update_game_over()
	end
end

function _draw()
	if state == game_states[1] then
		draw_menu()
	elseif state == game_states[2] then
		draw_game()
	elseif state == game_states[3] then
		draw_game_over()
	end
end

function update_game()
	-- debug
	do
		--move_boxes()
	end
	gm:update()
	for k,v in pairs(e) do
		v:update()
	end
	p:update()
end

-- delete
function move_boxes()
	local x = 0
	local y = 0
	local spd = 5
	if btn(➡️) then
		x += spd end
	if btn(⬅️) then
		x -= spd end
	if btn(⬇️) then
		y += spd end
	if btn(⬆️) then
		y -= spd end
	for k,v in pairs(gm.boxes) do
		v:move(v.pos+vector2.new(x,y))
	end
end

function update_menu()

end

function update_game_over()

end

function draw_game()
	cls()
	map(0,0,0,0,16,16)
	print("score: "..gm.score,80,0,10)
	for k,v in pairs(gm.boxes) do
		spr(v.sprt,v.pos.x,v.pos.y)
		print(gm.boxes[1].desp_timer,50,30,7)
	end
	for i=1,#gm.houses do
		print(gm.houses[i].is_free,80,9*i,colors[i])
	end
	for k,v in pairs(e) do
		v:draw()
	end
	p:draw()
	print(p_hit_spikes,50,110,12)
	print(p_hit_enemy,50,120,12)
end

function draw_menu()

end

function draw_game_over()

end

function start_game() 
	state = game_states[2]
	gm = game_mng.new()
end
